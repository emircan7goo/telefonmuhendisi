# Ortam Değişkenleri — telefonmühendisi.com

# === VERİTABANI ===
DATABASE_URL="postgresql://postgres:password@localhost:5432/telefonmuhendisi"

# === AUTH (NextAuth.js v5) ===
AUTH_SECRET="your-super-secret-key-min-32-chars-here"
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# === SMS (Netgsm) ===
NETGSM_USERNAME="your-netgsm-username"
NETGSM_PASSWORD="your-netgsm-password"
NETGSM_HEADER="TELEFONMUH"

# === YAPAY ZEKA (Gemini) ===
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# === DOSYA DEPOLAMA (Cloudflare R2) ===
CLOUDFLARE_R2_ACCOUNT_ID="your-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="telefonmuhendisi"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxx.r2.dev"
# "r2" yapılırsa yüklemeler R2'ye gider (public URL için custom domain gerekir). Boşsa base64 fallback.
UPLOAD_STORAGE=""

# === ÖDEME (iyzico) ===
IYZICO_API_KEY="your-iyzico-api-key"
IYZICO_SECRET_KEY="your-iyzico-secret-key"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# === E-POSTA (Resend) ===
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="Telefon Mühendisi <destek@telefonmuhendisi.com>"  # Resend'de dogrulanmis alan adi olmali

# Yeni talep bildirimleri (panelde Ayarlar -> "Bildirim E-postasi" doluysa o kullanilir)
SHOP_NOTIFY_EMAIL="destek@telefonmuhendisi.com"
# Yeni tamirlerin otomatik atanacagi teknisyen (panel ayari oncelikli)
DEFAULT_TECHNICIAN_EMAIL=""

# === AI ASISTAN (Gemini) — model adi (varsayilan: gemini-flash-latest) ===
GEMINI_MODEL="gemini-flash-latest"

# === REDIS ===
REDIS_URL="redis://localhost:6379"

# === UYGULAMA ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Telefon Mühendisi"
NODE_ENV="development"
